{
  "name": "@dirstack/ui",
  "description": "A shared React component library",
  "keywords": [
    "components",
    "design-system",
    "react",
    "tailwind",
    "ui"
  ],
  "homepage": "https://github.com/dirstack/ui#readme",
  "bugs": "https://github.com/dirstack/ui/issues",
  "license": "MIT",
  "author": {
    "name": "Piotr Kulpinski",
    "email": "piotr@kulpinski.pl",
    "url": "https://kulpinski.pl"
  },
  "repository": "git+https://github.com/dirstack/ui.git",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./variants": {
      "types": "./dist/lib/variants.d.ts",
      "default": "./dist/lib/variants.js"
    },
    "./classes": {
      "types": "./dist/lib/classes.d.ts",
      "default": "./dist/lib/classes.js"
    },
    "./interactive": {
      "types": "./dist/lib/interactive.d.ts",
      "default": "./dist/lib/interactive.js"
    },
    "./slot": {
      "types": "./dist/lib/slot.d.ts",
      "default": "./dist/lib/slot.js"
    },
    "./animation": {
      "types": "./dist/lib/animation.d.ts",
      "default": "./dist/lib/animation.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "prebuild": "bun run clean",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "sandbox": "cosmos",
    "sandbox:build": "cosmos-export",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@number-flow/react": "^0.6.1",
    "cn": "^0.2.4",
    "recharts": "^3.9.2",
    "sonner": "^2.0.8",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@dirstack/kodeks": "1.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.2.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "lefthook": "^2.1.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "react": "^19.2.7",
    "react-cosmos": "^7.4.1",
    "react-cosmos-plugin-vite": "^7.4.0",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.87.0",
    "rimraf": "^6.0.1",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.1.0",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1",
    "react": ">=19",
    "react-dom": ">=19",
    "react-hook-form": ">=7",
    "tailwindcss": ">=4",
    "tailwindcss-animate": ">=1"
  },
  "engines": {
    "node": ">=18"
  }
}
